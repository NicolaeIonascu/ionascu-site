---
// Visible FAQ + matching FAQPage JSON-LD (Google requires the markup to match visible content).
interface Props { items: { q: string; a: string }[]; heading?: string; /** less space above (when the previous section is also white) */ tight?: boolean; }
const { items, heading = 'Frequently asked questions', tight = false } = Astro.props;
const ld = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((i) => ({ '@type': 'Question', name: i.q, acceptedAnswer: { '@type': 'Answer', text: i.a } })),
};
---

{items.length > 0 && (
  <section class={`faq${tight ? ' faq-tight' : ''}`}>
    <div class="wrap prose">
      <h2>{heading}</h2>
      {items.map((i) => (
        <details>
          <summary>{i.q}</summary>
          <p>{i.a}</p>
        </details>
      ))}
    </div>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(ld)} />
  </section>
)}

<style>
  .faq-tight { padding-top: clamp(3rem, 6vw, 5rem); }
  /* the heading is the first thing in the section: no extra top margin from the text styles */
  .faq h2 { margin-top: 0; }
</style>
