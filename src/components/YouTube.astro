---
// Lightweight YouTube embed: shows the thumbnail only, loads the player on click.
// Keeps the page fast (no 500 KB of YouTube scripts per video) and respects privacy (youtube-nocookie).
import { Image } from 'astro:assets';
import { ytThumb } from '../data/projects';
import ikeaPoster from '../assets/ikea-cabinet-1280.jpg';

// Sharp, watermark-free posters used instead of YouTube's low-resolution thumbnail (any page that embeds these videos)
const CUSTOM_POSTERS: Record<string, ImageMetadata> = { lrt3ct5HByI: ikeaPoster };
interface Props { id: string; title: string; poster?: ImageMetadata; }
const { id, title, poster: posterProp } = Astro.props;
const poster = posterProp ?? CUSTOM_POSTERS[id];
---

<lite-yt data-id={id} data-title={title}>
  <a class="yt" href={`https://www.youtube.com/watch?v=${id}`} aria-label={`Play video: ${title}`}>
    {poster
      ? <Image src={poster} alt={title} widths={[760, 1280, 1520]} sizes="(max-width: 800px) 100vw, 760px" format="webp" quality={88} loading="lazy" decoding="async" />
      : <img src={ytThumb(id)} alt={title} width="480" height="360" loading="lazy" decoding="async" />}
    <span class="play"></span>
  </a>
</lite-yt>

<script>
  class LiteYT extends HTMLElement {
    connectedCallback() {
      this.querySelector('a')?.addEventListener('click', (e) => {
        e.preventDefault();
        const f = document.createElement('div');
        f.className = 'yt';
        f.innerHTML = `<iframe src="https://www.youtube-nocookie.com/embed/${this.dataset.id}?autoplay=1&rel=0" title="${this.dataset.title ?? 'Video'}" allow="autoplay; encrypted-media; picture-in-picture; fullscreen" allowfullscreen></iframe>`;
        this.replaceChildren(f);
      });
    }
  }
  if (!customElements.get('lite-yt')) customElements.define('lite-yt', LiteYT);
</script>
