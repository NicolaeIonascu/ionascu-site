---
import { Image } from 'astro:assets';
import { projectImage, projectTitle, type Project } from '../data/projects';
import { previews } from '../data/previews';
import { featuredTiles } from '../data/featured';
import { clipFor } from '../data/clips';
interface Props { project: Project; loading?: 'lazy' | 'eager'; }
const { project, loading = 'lazy' } = Astro.props;
// hover fragment (YouTube): the card preview chosen in the CRM, else the fragment of its home-page tile
const pv = previews[project.slug] ?? featuredTiles.find((t) => t.slug === project.slug);
const clip = pv ? clipFor(project.slug, pv.start ?? 0, pv.duration ?? 8) : undefined; // short local clip cut from the YouTube video

---

<a class="proj" href={`/portfolio/${project.slug}/`} data-cat={project.category} data-clip={clip}>
  <div class="proj-media">
    <Image src={projectImage(project)} alt={`${projectTitle(project)} – video preview`} widths={[360, 560, 720]} sizes="(max-width: 600px) 100vw, 360px" format="webp" loading={loading} />
    {clip && <video class="clip" muted loop playsinline preload="none" tabindex="-1" aria-hidden="true"></video>}
  </div>
  <div class="body">
    <span class="tag">{project.category}</span>
    <h3>{project.brand}{project.product ? ` ${project.product}` : ''}</h3>
  </div>
</a>

<script>
  // Hover / keyboard focus plays the clip on top of the thumbnail. Only for devices that can hover, never with reduced motion or Save-Data.
  const canHover = matchMedia('(hover: hover) and (pointer: fine)').matches;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const saveData = (navigator as any).connection?.saveData;
  if (canHover && !reduce && !saveData) {
    document.querySelectorAll<HTMLAnchorElement>('.proj[data-clip]').forEach((card) => {
      const video = card.querySelector<HTMLVideoElement>('.clip')!;
      const start = () => {
        if (!video.src) video.src = card.dataset.clip!;
        video.currentTime = 0;
        video.play().then(() => card.classList.add('playing')).catch(() => {});
      };
      const stop = () => { card.classList.remove('playing'); video.pause(); };
      card.addEventListener('pointerenter', (e) => { if ((e as PointerEvent).pointerType === 'mouse') start(); });
      card.addEventListener('pointerleave', stop);
      card.addEventListener('focus', start);
      card.addEventListener('blur', stop);
    });
  }
</script>
