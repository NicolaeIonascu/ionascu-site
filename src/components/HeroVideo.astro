---
// Full-width hero background: poster image (fast, LCP) + optional looping muted video loaded AFTER the page.
// The video is AV1 only (half the size of H.264 at the same quality). Browsers that cannot play AV1, reduced-motion, Save-Data and slow
// connections simply keep the poster image. It pauses when scrolled out of view.
import { Image } from 'astro:assets';
import poster from '../assets/hero-poster.png';
---

<div class="hero-media" aria-hidden="true">
  <Image src={poster} alt="" widths={[640, 960, 1280, 1920]} sizes="100vw" format="webp" quality={80} loading="eager" fetchpriority="high" class="hero-poster" />
  <video class="hero-video" muted loop playsinline preload="none" tabindex="-1" data-src-xl="/video/hero-3840.av1.mp4" data-src-lg="/video/hero-1920.av1.mp4" data-src-sm="/video/hero-1280.av1.mp4"></video>
</div>
<div class="hero-shade" aria-hidden="true"></div>
<button type="button" class="hero-toggle" aria-label="Pause background video" hidden>
  <span class="pause"></span>
</button>

<script>
  const video = document.querySelector<HTMLVideoElement>('.hero-video');
  const toggle = document.querySelector<HTMLButtonElement>('.hero-toggle');
  if (video && toggle) {
    const conn = (navigator as any).connection;
    const slow = conn && (conn.saveData || /(^|-)2g$|3g/.test(conn.effectiveType || ''));
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let userPaused = false;

    const start = () => {
      // phones get 720p, normal screens 1080p, 4K / large retina screens (2560+ device pixels wide) the full 4K file
      const px = innerWidth * (devicePixelRatio || 1);
      video.src = matchMedia('(max-width: 700px)').matches ? video.dataset.srcSm! : px >= 2560 ? video.dataset.srcXl! : video.dataset.srcLg!;
      video.addEventListener('playing', () => { video.classList.add('on'); toggle.hidden = false; }, { once: true });
      video.play().catch(() => {}); // blocked autoplay: the poster simply stays
      new IntersectionObserver(([e]) => {
        if (userPaused) return;
        e.isIntersecting ? video.play().catch(() => {}) : video.pause();
      }).observe(video);
    };

    const av1 = !!video.canPlayType('video/mp4; codecs="av01.0.08M.08"');
    if (!slow && !reduce && av1) {
      // wait until the page has finished loading, so the video never competes with it
      const go = () => ('requestIdleCallback' in window ? requestIdleCallback(start, { timeout: 2500 }) : setTimeout(start, 800));
      document.readyState === 'complete' ? go() : addEventListener('load', go, { once: true });
    }

    toggle.addEventListener('click', () => {
      userPaused = !video.paused;
      userPaused ? video.pause() : video.play();
      toggle.classList.toggle('paused', userPaused);
      toggle.setAttribute('aria-label', userPaused ? 'Play background video' : 'Pause background video');
    });
  }
</script>
