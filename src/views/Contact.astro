---
// Contact page, used for /contact/ and /ro/contact/
import PageBanner from '../components/PageBanner.astro';
import Base from '../layouts/Base.astro';
import { SITE } from '../data/site';
import { getLang, lp } from '../i18n';
import { contactText } from '../i18n/pages';

const lang = getLang(Astro.url);
const c = contactText[lang];
const formReady = !SITE.formKey.startsWith('YOUR_');
---

<Base title={c.title} image="/og/contact.jpg" description={c.description}>
  <PageBanner video="sky" eyebrow={c.eyebrow} crumb={c.crumb}>
    <h1>{c.h1}</h1>
    <p class="lead">{c.lead}</p>
  </PageBanner>
  <section>
    <div class="wrap split" style="align-items:start">
      {formReady ? (
        <form class="contact" action="https://api.web3forms.com/submit" method="POST">
          <input type="hidden" name="access_key" value={SITE.formKey} />
          <input type="hidden" name="subject" value={c.subject} />
          <input type="hidden" name="redirect" value={`${SITE.url}${lp(lang, '/thank-you/')}`} />
          <input type="checkbox" name="botcheck" class="hp" tabindex="-1" autocomplete="off" />
          <label>{c.labels.name}<input name="name" required autocomplete="name" /></label>
          <label>{c.labels.email}<input type="email" name="email" required autocomplete="email" /></label>
          <label>{c.labels.company}<input name="company" autocomplete="organization" /></label>
          <label>{c.labels.message}<textarea name="message" rows="6" required placeholder={c.placeholder}></textarea></label>
          <button class="btn" type="submit">{c.send}</button>
        </form>
      ) : (
        <div class="card">
          <h2 style="font-size:1.2rem">{c.directH2}</h2>
          <p><a href={`mailto:${SITE.email}?subject=${c.mailSubject}`}>{SITE.email}</a></p>
          <p class="muted" style="margin:0">{c.soon}</p>
        </div>
      )}
      <div class="prose">
        <h2 style="margin-top:0">{c.otherH2}</h2>
        <ul>
          <li>{c.emailLabel}<a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
          <li><a href={SITE.social.linkedin} rel="me noopener" target="_blank">LinkedIn</a></li>
          <li><a href={SITE.social.youtube} rel="me noopener" target="_blank">{c.youtube}</a></li>
          <li><a href={SITE.social.fiverr} rel="me noopener" target="_blank">{c.fiverr}</a></li>
        </ul>
        <p class="muted">{c.tip}</p>
      </div>
    </div>
  </section>
</Base>
