---
// Portfolio: every project as an expanding video tile, four per row (the hovered tile widens and plays its clip).
import PageBanner from '../../components/PageBanner.astro';
import Base from '../../layouts/Base.astro';
import FeatureTiles from '../../components/FeatureTiles.astro';
import { projects } from '../../data/projects';
import { previews } from '../../data/previews';
import { featuredTiles } from '../../data/featured';

const PER_ROW = 4;
// every project with its chosen fragment (card preview first, then the home-tile one)
const items = projects.map((p) => {
  const f = previews[p.slug] ?? featuredTiles.find((t) => t.slug === p.slug);
  return { slug: p.slug, start: f?.start ?? 0, duration: f?.duration ?? 8 };
});
const rows: (typeof items)[] = [];
for (let i = 0; i < items.length; i += PER_ROW) rows.push(items.slice(i, i + PER_ROW));
---

<Base
  title="Portfolio: 3D Assembly & Installation Animations | IONASCU"
  description="Portfolio of 3D assembly and installation instruction animations for furniture, roofing, drainage, siding, lighting and yard products."
>
  <PageBanner video="roof" eyebrow="Selected work" crumb="Portfolio">
    <h1>Portfolio</h1>
    <p class="lead">Assembly and installation animations for manufacturers. Move the mouse over a tile to preview the video, click to open the project.</p>
  </PageBanner>
  <section>
    <div class="wrap portfolio-tiles">
      {rows.map((row) => <FeatureTiles items={row} />)}
    </div>
  </section>
</Base>

<style is:global>
  .portfolio-tiles .tiles { margin-bottom: 1.25rem; }
  /* a last row with fewer tiles keeps the same tile width as the full rows */
  @media (min-width: 861px) {
    .portfolio-tiles .tiles:has(.tile:nth-child(1):last-child) { max-width: calc((100% - 3.75rem) / 4); }
    .portfolio-tiles .tiles:has(.tile:nth-child(2):last-child) { max-width: calc((100% - 3.75rem) / 4 * 2 + 1.25rem); }
    .portfolio-tiles .tiles:has(.tile:nth-child(3):last-child) { max-width: calc((100% - 3.75rem) / 4 * 3 + 2.5rem); }
  }
</style>