---
import Base from '../../layouts/Base.astro';
import YouTube from '../../components/YouTube.astro';
import Faq from '../../components/Faq.astro';
import { services, commonFaq, videoTitles, type Service } from '../../data/services';
import { projects } from '../../data/projects';
import { SITE } from '../../data/site';

export function getStaticPaths() {
  return services.map((s) => ({ params: { slug: s.slug }, props: { service: s } }));
}

const { service: s } = Astro.props as { service: Service };
const url = `${SITE.url}/services/${s.slug}/`;
const faq = [...s.faq, ...commonFaq];
const ld = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: s.name,
    description: s.seoDescription,
    url,
    provider: { '@id': `${SITE.url}/#organization` },
    areaServed: 'Worldwide',
    serviceType: s.name,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url + '/' },
      { '@type': 'ListItem', position: 2, name: 'Services', item: SITE.url + '/services/' },
      { '@type': 'ListItem', position: 3, name: s.name, item: url },
    ],
  },
];
const others = services.filter((x) => x.slug !== s.slug);
const titleFor = (id: string) => {
  if (videoTitles[id]) return videoTitles[id];
  const p = projects.find((p) => p.youtube === id);
  return p ?`${p.brand}${p.product ? ' ' + p.product : ''} – 3D animation` : '3D animation example';
};
---

<Base title={s.seoTitle} description={s.seoDescription} jsonLd={ld} image={`/og/service-${s.slug}.jpg`}>
  <div class="wrap page-head">
    <p class="crumbs"><a href="/">Home</a> / <a href="/services/">Services</a> / {s.name}</p>
    <h1>{s.h1}</h1>
    <p class="lead">{s.lead}</p>
    <p class="head-cta"><a class="btn" href="/contact/">Request a quote</a></p>
  </div>

  {s.sections && s.sections.length > 0 && (
    <section class="after-head">
      <div class="wrap"><div class="prose service-article">
        {s.sections.map((sec) => (
          <Fragment>
            <h2>{sec.title}</h2>
            {sec.paragraphs?.map((p) => <p>{p}</p>)}
            {sec.bullets && <ul>{sec.bullets.map((b) => <li set:html={b} />)}</ul>}
          </Fragment>
        ))}
      </div></div>
    </section>
  )}

  {s.featured && (
    <section class="alt service-featured">
      <div class="wrap"><div class="prose">
        <h2>Example: {s.featured.title}</h2>
        <YouTube id={s.featured.id} title={s.featured.title} />
        <p style="margin-top:1rem">{s.featured.text}</p>
      </div></div>
    </section>
  )}

  <section>
    <div class="wrap grid-3">
      {s.points.map((p) => (
        <div class="card"><h3>{p.title}</h3><p class="muted" style="margin:0">{p.text}</p></div>
      ))}
    </div>
  </section>

  {s.videos.length > 0 && (
    <section class="alt">
      <div class="wrap">
        <h2>Examples</h2>
        <div class="grid-3">
          {s.videos.map((id) => <YouTube id={id} title={titleFor(id)} />)}
        </div>
        <p class="more-row"><a href="/portfolio/">More projects →</a></p>
      </div>
    </section>
  )}

  <Faq items={faq} />

  <section class="alt">
    <div class="wrap">
      <h2>Related services</h2>
      <div class="grid-3">
        {others.slice(0, 3).map((o) => (
          <a class="card" href={`/services/${o.slug}/`}><h3>{o.name}</h3><span class="more">Learn more →</span></a>
        ))}
      </div>
    </div>
  </section>

  <section class="dark cta">
    <div class="wrap">
      <h2>Tell me about your product</h2>
      <p class="lead muted">Send your manual or drawings and get a clear plan and quote.</p>
      <div class="actions"><a class="btn" href="/contact/">Get a quote</a></div>
    </div>
  </section>
</Base>
