---
// Test page: the whole portfolio shown like the home-page tiles (four per row, the hovered one widens and plays its clip).
import PageBanner from '../../components/PageBanner.astro';
import Base from '../../layouts/Base.astro';
import FeatureTiles from '../../components/FeatureTiles.astro';
import { projects } from '../../data/projects';
import { previews } from '../../data/previews';
import { featuredTiles } from '../../data/featured';

// every project with its chosen fragment (card preview first, then the home-tile one)
const items = projects.map((p) => {
  const f = previews[p.slug] ?? featuredTiles.find((t) => t.slug === p.slug);
  return { slug: p.slug, start: f?.start ?? 0, duration: f?.duration ?? 8 };
});
const rows: (typeof items)[] = [];
for (let i = 0; i < items.length; i += 4) rows.push(items.slice(i, i + 4));
---

<Base
  title="Portfolio 2 (test) | IONASCU"
  description="Test layout of the portfolio: expanding video tiles."
  noindex
>
  <PageBanner video="roof" eyebrow="Selected work" crumb="Portfolio 2">
    <h1>Portfolio 2</h1>
    <p class="lead">The same projects in the home-page style. Move the mouse over a tile.</p>
  </PageBanner>
  <section>
    <div class="wrap portfolio2">
      {rows.map((row) => <FeatureTiles items={row} />)}
    </div>
  </section>
</Base>

<style is:global>
  .portfolio2 .tiles { margin-bottom: 1.25rem; }
</style>
